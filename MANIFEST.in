include README.md
include LICENSE
include IOBRpy.png
include agent-manifest.json
include setup.py

recursive-include src/iobrpy/resources *.pkl *.gmt *.txt
recursive-include src/iobrpy/RAG_MCP *.json
recursive-include src/iobrpy/utils *.py
recursive-include agent-harness/iobrpy_cli *.py README.md
recursive-include agent-harness/iobrpy_cli/iobrpy/agent_assets *
recursive-include agent-harness/iobrpy_result *.py
recursive-include agent-harness/iobrpy_result/agent_assets *

prune recipe
prune build
prune dist
prune agent-harness/build
prune agent-harness/iobrpy_cli.egg-info
prune agent-harness/iobrpy_cli/iobrpy/tests
prune src/iobrpy.egg-info
prune iobrpy.egg-info
prune .eggs

global-exclude *.py[cod] .DS_Store
recursive-exclude * __pycache__
